Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        hwloc \
        hwloc-nox \

%environment
    export OMP_PROC_BIND=true
    export OMP_PLACES=cores

%help
    This container provides the build environment for Qlassical.
    It includes GCC 13, CMake 3.28, Git, and HWLoc.
    
    Usage:
    apptainer shell qlassical_env.sif
    apptainer exec qlassical_env.sif cmake .. && make