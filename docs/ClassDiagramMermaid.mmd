classDiagram
    %%  FRONTEND 
    namespace Frontend {
        class GateType {
            <<enumeration>>
            H, X, CNOT, RX, CUSTOM, FUSED_BLOCK, MEASURE
        }
        
        class Gate {
            <<struct>>
            +GateType type
            +int target
            +int control
            +double param
            +vector~complex~ matrix
        }

        class QuantumCircuit {
            -int num_qubits
            -vector~Gate~ operations
            +QuantumCircuit(int num_qubits)
            +h(int target) QuantumCircuit&
            +cx(int control, int target) QuantumCircuit&
            +rx(double theta, int target) QuantumCircuit&
            +measure_all() QuantumCircuit&
            +get_operations() vector~Gate~
            +get_num_qubits() int
        }
    }

    %%  MIDDLE-END 
    namespace MiddleEnd {
        class HardwareEnvironment {
            <<interface>>
            +detect_topology()*
            +get_l3_cache_size()* size_t
            +get_num_cores()* int
        }
        
        class LinuxHardwareEnv {
            +detect_topology()
            +get_l3_cache_size() size_t
        }
        
        class WindowsHardwareEnv {
            +detect_topology()
            +get_l3_cache_size() size_t
        }

        class ExecutionPlan {
            -vector~Gate~ optimized_operations
            -int num_qubits
            +get_plan() vector~Gate~
        }

        class ExecutionPlanner {
            -HardwareEnvironment hw_env
            +compile(QuantumCircuit circuit) ExecutionPlan
            -build_dag(vector~Gate~ ops) DAG
            -fuse_gates_for_cache(DAG dag, size_t cache_limit) vector~Gate~
        }
    }

    %%  BACKEND 
    namespace Backend {
        
        %% Memory Hierarchy
        class StateVectorManager {
            <<interface>>
            +allocate()*
            +get_size()* size_t
            +get_probability(size_t global_index)* double
        }

        class CPUStateVector {
            -complex* aligned_data
            +allocate()
            +get_size() size_t
            +get_probability(size_t global_index) double
            +get_raw_pointer() complex*
        }

        class MPIStateVector {
            -complex* local_chunk
            -int mpi_rank
            +allocate()
            +get_size() size_t
            +get_probability(size_t global_index) double
            -fetch_from_remote_node(size_t global_index) double
        }

        %% Engine hierarchy 
        class ExecutionEngine {
            <<interface>>
            +execute(ExecutionPlan plan)*
            +get_state()* StateVectorManager
        }

        class CPUExecutionEngine {
            -CPUStateVector state_manager
            +execute(ExecutionPlan plan)
            +get_state() StateVectorManager
        }
        
        class MPIExecutionEngine {
            -MPIStateVector state_manager
            +execute(ExecutionPlan plan)
            +get_state() StateVectorManager
        }

        class MeasurementManager {
            -StateVectorManager state_ref
            +MeasurementManager(StateVectorManager state)
            +sample_shots(int num_shots) map~string, int~
        }
    }

    %% Relations and data-flow
    
    %% Frontend
    QuantumCircuit *-- Gate : Contains
    Gate *-- GateType : Contains
    
    %% Middle-End
    HardwareEnvironment <|-- LinuxHardwareEnv : Implements
    HardwareEnvironment <|-- WindowsHardwareEnv : Implements
    ExecutionPlanner ..> QuantumCircuit : Reads
    ExecutionPlanner ..> ExecutionPlan : Generates
    ExecutionPlanner --> HardwareEnvironment : Interrogates
    
    %% Backend 
    StateVectorManager <|-- CPUStateVector : Implements
    StateVectorManager <|-- MPIStateVector : Implements
    
    ExecutionEngine <|-- CPUExecutionEngine : Implements
    ExecutionEngine <|-- MPIExecutionEngine : Implements
    ExecutionEngine ..> ExecutionPlan : Consumes
    
    CPUExecutionEngine *-- CPUStateVector : Owns
    MPIExecutionEngine *-- MPIStateVector : Owns
    
    MeasurementManager --> StateVectorManager : Reads probabilities via interface
